// Place your settings in this file to overwrite default and user settings.
{
    "files.exclude": {
        "out": false, // set this to true to hide the "out" folder with the compiled JS files
        "dist": false // set this to true to hide the "dist" folder with the compiled JS files
    },
    "search.exclude": {
        "out": true, // set this to false to include "out" folder in search results
        "dist": true // set this to false to include "dist" folder in search results
    },
    // Turn off tsc task auto detection since we have the necessary tasks as npm scripts
    "js/ts.tsc.autoDetect": "off",
    "flm-vscode.externalAgents": [
        {
            "name": "aider",
            "command": "aider",
            "args": [
                "--no-fancy-input",
                "--no-pretty",
                "--no-check-update",
                "--no-show-release-notes",
                "--yes-always",
                "--message",
                "{prompt}"
            ],
            "versionArgs": ["--version"],
            "installCommand": "pip",
            "installArgs": ["install", "--upgrade", "aider-chat"],
            "latestVersionUrl": "https://pypi.org/pypi/aider-chat/json",
            "latestVersionField": "info.version"
        },
        {
            "name": "hermes",
            "command": "hermes",
            "args": ["-z", "{prompt}"],
            "versionArgs": ["--version"]
        },
        {
            "name": "codex",
            "command": "codex",
            "args": ["exec", "{prompt}"],
            "versionArgs": ["--version"],
            "installCommand": "npm",
            "installArgs": ["install", "-g", "@openai/codex@{version}"],
            "latestVersionUrl": "https://registry.npmjs.org/@openai/codex/latest",
            "latestVersionField": "version"
        },
        {
            "name": "pi",
            "command": "pi",
            "args": ["--print", "{prompt}"],
            "versionArgs": ["--version"],
            "installCommand": "npm",
            "installArgs": ["install", "-g", "@mariozechner/pi-coding-agent@{version}"],
            "latestVersionUrl": "https://registry.npmjs.org/@mariozechner/pi-coding-agent/latest",
            "latestVersionField": "version"
        },
        {
            "name": "opencode",
            "command": "opencode",
            "args": ["run", "{prompt}"],
            "versionArgs": ["--version"]
        },
    ]
}